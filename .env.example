# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Internal API key required on the `x-api-key` header for protected routes.
INTERNAL_API_KEY=change-me

