# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Internal API key required on the `x-api-key` header for protected routes.
INTERNAL_API_KEY=change-me

# ---------------------------------------------------------------------------
# Toutbox (vendor)
# ---------------------------------------------------------------------------
# Local dev: docker-compose.yml already points this at the wiremock service.
TOUTBOX_BASE_URL=http://localhost:8443
TOUTBOX_API_KEY=local-dev-toutbox-api-key

# API key Toutbox must send us on POST /webhook/delivery-orders. Separate
# from INTERNAL_API_KEY, which authenticates BSS modules calling in — Toutbox
# is an external vendor, a different trust domain.
TOUTBOX_WEBHOOK_API_KEY=change-me

# ---------------------------------------------------------------------------
# wave-delivery-api
# ---------------------------------------------------------------------------
# Called back with delivery status updates translated from the Toutbox
# webhook. WAVE_DELIVERY_API_KEY must match that service's own INTERNAL_API_KEY.
WAVE_DELIVERY_API_BASE_URL=http://localhost:3000
WAVE_DELIVERY_API_KEY=change-me

# ---------------------------------------------------------------------------
# New Relic (observability)
# ---------------------------------------------------------------------------
NEW_RELIC_APP_NAME=toutbox-carrier-service
NEW_RELIC_LICENSE_KEY=your-license-key-here
NEW_RELIC_ENABLED=false
