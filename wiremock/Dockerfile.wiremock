# ---------------------------------------------------------------------------
# Packages this repository's WireMock stubs for the Toutbox vendor API as a
# standalone image. Build context is this wiremock/ directory itself, not the
# repository root — the image's only inputs are mappings/ and __files/ below.
# The same image runs in local development (docker-compose), CI, and Pact
# provider verification (ADR 0000 in tim-network-adapter) — see ADR 0001
# there for why this is a separate image per network adapter repository
# rather than a shared one.
# ---------------------------------------------------------------------------
FROM wiremock/wiremock:3.9.1

COPY mappings /home/wiremock/mappings
COPY __files /home/wiremock/__files
