{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/Courier/CostAndDeliveryTime",
    "headers": {
      "Authorization": {
        "equalTo": "local-dev-toutbox-api-key"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.cepDestino",
          "equalTo": "99999999"
        }
      }
    ]
  },
  "response": {
    "status": 404,
    "bodyFileName": "toutbox/courier/cost-and-delivery-time-cep-not-found-response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
