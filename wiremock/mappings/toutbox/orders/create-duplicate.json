{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/external/orders",
    "headers": {
      "Authorization": {
        "equalTo": "local-dev-toutbox-api-key"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.itens[0].frete.destinatario.cep",
          "equalTo": "11111111"
        }
      }
    ]
  },
  "response": {
    "status": 409,
    "bodyFileName": "toutbox/orders/create-duplicate-response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
